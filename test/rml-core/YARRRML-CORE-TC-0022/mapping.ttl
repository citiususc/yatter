@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix rml: <http://w3id.org/rml/>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix ql: <http://semweb.mmlab.be/ns/ql#>.
@prefix d2rq: <http://www.wiwiss.fu-berlin.de/suhl/bizer/D2RQ/0.1#>.
@prefix schema: <http://schema.org/>.
@prefix formats: <http://www.w3.org/ns/formats/>.
@prefix void: <http://rdfs.org/ns/void#>.
@prefix grel: <http://users.ugent.be/~bjdmeest/function/grel.ttl#>.
@base <http://example.com/ns#>.


<student_0> a rml:TriplesMap;

	rml:logicalSource [
		a rml:LogicalSource;
		rml:source [ a rml:Source, rml:FilePath;
			rml:path "Student.csv";
		];
		rml:referenceFormulation rml:CSV
	];
	rml:subjectMap [
		a rml:SubjectMap;
		rml:template "http://example.com/resource/student_{ID}";
		rml:graphMap [
			a rml:GraphMap;
			rml:constant <http://example.com/graph/students>;
		];
	];
	rml:predicateObjectMap [
		rml:predicateMap [
			a rml:PredicateMap;
			rml:constant rdf:type;
		];
		rml:objectMap [
			a rml:ObjectMap;
			rml:constant <http://example.com/ontology/Student>;
		];
	];
	rml:predicateObjectMap [
		rml:predicateMap [
			a rml:PredicateMap;
			rml:constant foaf:Name;
		];
		rml:objectMap [
			a rml:ObjectMap;
			rml:reference "Name";
		];
		rml:graphMap [
			a rml:GraphMap;
			rml:constant <http://example.com/graph/students>;
		];
	];
	rml:predicateObjectMap [
		rml:predicateMap [
			a rml:PredicateMap;
			rml:constant <http://example.com/ontology/practises>;
		];
		rml:objectMap [
			a rml:RefObjectMap;
			rml:parentTriplesMap <sport_0>;
			rml:joinCondition [
				rml:child "Sport";
				rml:parent "Name";
			];
		];
		rml:graphMap [
			a rml:GraphMap;
			rml:constant <http://example.com/graph/practise>;
		];
	].


<sport_0> a rml:TriplesMap;

	rml:logicalSource [
		a rml:LogicalSource;
		rml:source [ a rml:Source, rml:FilePath;
			rml:path "Sport.csv";
		];
		rml:referenceFormulation rml:CSV
	];
	rml:subjectMap [
		a rml:SubjectMap;
		rml:template "http://example.com/resource/sport_{ID}";
		rml:graphMap [
			a rml:GraphMap;
			rml:constant <http://example.com/graph/sports>;
		];
	];
	rml:predicateObjectMap [
		rml:predicateMap [
			a rml:PredicateMap;
			rml:constant rdf:type;
		];
		rml:objectMap [
			a rml:ObjectMap;
			rml:constant <http://example.com/ontology/Sport>;
		];
	];
	rml:predicateObjectMap [
		rml:predicateMap [
			a rml:PredicateMap;
			rml:constant rdfs:label;
		];
		rml:objectMap [
			a rml:ObjectMap;
			rml:reference "Name";
		];
	].
