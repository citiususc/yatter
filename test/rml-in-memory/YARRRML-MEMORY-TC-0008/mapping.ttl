@prefix insta: <http://instagram.com/data/>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix sd: <https://w3id.org/okn/o/sd#>.
@prefix kg4di: <https://w3id.org/kg4di/>.
@prefix rml: <http://w3id.org/rml/>.
@prefix ql: <http://semweb.mmlab.be/ns/ql#>.
@prefix d2rq: <http://www.wiwiss.fu-berlin.de/suhl/bizer/D2RQ/0.1#>.
@prefix schema: <http://schema.org/>.
@prefix formats: <http://www.w3.org/ns/formats/>.
@prefix void: <http://rdfs.org/ns/void#>.
@prefix grel: <http://users.ugent.be/~bjdmeest/function/grel.ttl#>.
@base <http://example.com/ns#>.


<df_map_0> a rml:TriplesMap;

	rml:logicalSource [
		a rml:LogicalSource;
		rml:source [
			a sd:DatasetSpecification;
			sd:name "variable1";
			sd:hasDataTransformation[
				sd:hasSourceCode[
					sd:programmingLanguage "Python3.9";
				];
			];
		];
		rml:iterator "$.users[*]";
		rml:referenceFormulation ql:Dictionary;
	];
	rml:subjectMap [
		a rml:SubjectMap;
		rml:template "http://instagram.com/data/user{id}";
	];
	rml:predicateObjectMap [
		rml:predicateMap [
			a rml:PredicateMap;
			rml:constant rdf:type;
		];
		rml:objectMap [
			a rml:ObjectMap;
			rml:constant insta:User;
		];
	];
	rml:predicateObjectMap [
		rml:predicateMap [
			a rml:PredicateMap;
			rml:constant insta:username;
		];
		rml:objectMap [
			a rml:ObjectMap;
			rml:reference "Username";
		];
	];
	rml:predicateObjectMap [
		rml:predicateMap [
			a rml:PredicateMap;
			rml:constant insta:name;
		];
		rml:objectMap [
			a rml:ObjectMap;
			rml:template "{Name} {Surname}";
		];
	];
	rml:predicateObjectMap [
		rml:predicateMap [
			a rml:PredicateMap;
			rml:constant insta:follows;
		];
		rml:objectMap [
			a rml:ObjectMap;
			rml:template "http://instagram.com/data/user{Follows}";
			rml:termType rml:IRI
		];
	].


<df_map_1> a rml:TriplesMap;

	rml:logicalSource [
		a rml:LogicalSource;
		rml:source [ a rml:Source, rml:FilePath;
			rml:path "followersperson.json";
		];
		rml:referenceFormulation rml:JSONPath;
		rml:iterator "$.followers[*]"
	];
	rml:subjectMap [
		a rml:SubjectMap;
		rml:template "http://instagram.com/data/user{id}";
	];
	rml:predicateObjectMap [
		rml:predicateMap [
			a rml:PredicateMap;
			rml:constant rdf:type;
		];
		rml:objectMap [
			a rml:ObjectMap;
			rml:constant insta:User;
		];
	];
	rml:predicateObjectMap [
		rml:predicateMap [
			a rml:PredicateMap;
			rml:constant insta:username;
		];
		rml:objectMap [
			a rml:ObjectMap;
			rml:reference "Username";
		];
	];
	rml:predicateObjectMap [
		rml:predicateMap [
			a rml:PredicateMap;
			rml:constant insta:name;
		];
		rml:objectMap [
			a rml:ObjectMap;
			rml:template "{Name} {Surname}";
		];
	];
	rml:predicateObjectMap [
		rml:predicateMap [
			a rml:PredicateMap;
			rml:constant insta:follows;
		];
		rml:objectMap [
			a rml:ObjectMap;
			rml:template "http://instagram.com/data/user{Follows}";
			rml:termType rml:IRI
		];
	].


ql:Dictionary a rml:ReferenceFormulation;
	kg4di:definedBy "Python".
