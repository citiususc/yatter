@prefix ex: <http://www.semanticweb.org/tijnd/>.
@prefix ontology: <http://www.semanticweb.org/tijnd/ontology/>.
@prefix schema: <https://schema.org/>.
@prefix idlab-fn: <http://example.com/idlab/function/>.
@prefix grel: <http://users.ugent.be/~bjdmeest/function/grel.ttl#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix rml: <http://w3id.org/rml/>.
@prefix ql: <http://semweb.mmlab.be/ns/ql#>.
@prefix d2rq: <http://www.wiwiss.fu-berlin.de/suhl/bizer/D2RQ/0.1#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix schema: <http://schema.org/>.
@prefix formats: <http://www.w3.org/ns/formats/>.
@prefix void: <http://rdfs.org/ns/void#>.
@base <http://example.com/ns#>.


<function_director_0> a rml:FunctionExecution;
	rml:function grel:string_split ;
	rml:input
		[
			a rml:Input;
			rml:parameter grel:p_string_sep;
			rml:inputValueMap [
				a rml:TermMap;
				rml:constant ", ";
			];
		],
		[
			a rml:Input;
			rml:parameter grel:valueParameter;
			rml:inputValueMap [
				a rml:TermMap;
				rml:reference "directors";
			];
		].

<director_0> a rml:TriplesMap;

	rml:logicalSource [
		a rml:LogicalSource;
		rml:source [ a rml:Source, rml:FilePath;
			rml:path "imdb_video_game_rating_modified.csv";
		];
		rml:referenceFormulation rml:CSV
	];
	rml:subjectMap [
		a rml:SubjectMap;
		rml:template "http://www.semanticweb.org/tijnd/Person/{title}";
	];
	rml:predicateObjectMap [
		rml:predicateMap [
			a rml:PredicateMap;
			rml:constant rdf:type;
		];
		rml:objectMap [
			a rml:ObjectMap;
			rml:constant schema:Person;
		];
	];
	rml:predicateObjectMap [
		rml:predicateMap [
			a rml:PredicateMap;
			rml:constant schema:name;
		];
		rml:objectMap [
			a rml:ObjectMap;
			rml:functionExecution <function_director_0>;
		];
	].
