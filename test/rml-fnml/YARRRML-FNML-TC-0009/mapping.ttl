@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix ex: <http://example.com/>.
@prefix rml: <http://w3id.org/rml/>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix ql: <http://semweb.mmlab.be/ns/ql#>.
@prefix d2rq: <http://www.wiwiss.fu-berlin.de/suhl/bizer/D2RQ/0.1#>.
@prefix schema: <http://schema.org/>.
@prefix formats: <http://www.w3.org/ns/formats/>.
@prefix void: <http://rdfs.org/ns/void#>.
@prefix grel: <http://users.ugent.be/~bjdmeest/function/grel.ttl#>.
@base <http://example.com/ns#>.


<student2_0> a rml:TriplesMap;

	rml:logicalSource [
		a rml:LogicalSource;
		rml:source [ a rml:Source, rml:FilePath;
			rml:path "student.csv";
		];
		rml:referenceFormulation rml:CSV
	];
	rml:subjectMap [
		a rml:SubjectMap;
		rml:template "http://example.com/{Name}";
	];
	rml:predicateObjectMap [
		rml:predicateMap [
			a rml:PredicateMap;
			rml:constant foaf:name;
		];
		rml:objectMap [
			a rml:RefObjectMap;
			rml:parentTriplesMap <mapping1_0>;
			rml:joinCondition [
				rml:child "val1";
				rml:parent "val2";
			];
			rml:joinCondition [
				rml:child "val1";
				rml:parent "val2";
			];
		];
		rml:objectMap [
			a rml:RefObjectMap;
			rml:parentTriplesMap <mapping1_0>;
			rml:joinCondition [
				rml:child "val1";
				rml:parent "val2";
			];
		];
	];
	rml:predicateObjectMap [
		rml:predicateMap [
			a rml:PredicateMap;
			rml:constant foaf:surname;
		];
		rml:objectMap [
			a rml:RefObjectMap;
			rml:parentTriplesMap <mapping2_0>;
			rml:joinCondition [
				rml:child "val1";
				rml:parent "val2";
			];
		];
	].


<mapping1_0> a rml:TriplesMap;

	rml:logicalSource [
		a rml:LogicalSource;
		rml:source [ a rml:Source, rml:FilePath;
			rml:path "student.csv";
		];
		rml:referenceFormulation rml:CSV
	];
	rml:subjectMap [
		a rml:SubjectMap;
		rml:template "http://example.com/{Name}";
	].


<mapping2_0> a rml:TriplesMap;

	rml:logicalSource [
		a rml:LogicalSource;
		rml:source [ a rml:Source, rml:FilePath;
			rml:path "student.csv";
		];
		rml:referenceFormulation rml:CSV
	];
	rml:subjectMap [
		a rml:SubjectMap;
		rml:template "http://example.com/{surname}";
	].
